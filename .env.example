ALLURE_ENDPOINT=https://allure.qa.guru
ALLURE_API_TOKEN=your-api-token-here
ALLURE_API_PREFIX=/api/rs

WORKFLOW_ID=6
AUTOMATED_WORKFLOW_ID=5

# Status IDs — see src/automator/statuses.py (workflow 6 «Ручные тесты»)
STATUS_DRAFT_ID=-1
STATUS_REVIEW_ID=14
STATUS_AUTOMATE_ID=5
# Optional: «AI автоматизирует» in workflow 6 (in-progress)
# STATUS_AI_AUTOMATING_ID=17
# Optional: «Сломано AI» in workflow 6 (failure)
# STATUS_AI_FAILED_ID=16
# Success: workflow 5 «Автоматизированные тесты», status «Автоматизировано с AI»
STATUS_AUTOMATED_DONE_ID=13

# Start with one project; leave empty to scan all accessible projects (3156+)
MONITOR_PROJECT_IDS=5267

POLL_INTERVAL_SEC=30
MAX_CONCURRENT_PROJECT_REQUESTS=5
DATABASE_PATH=/app/data/automator.db
DRY_RUN=false
LOG_LEVEL=INFO

# GitHub: per-TestOps-project repos under this org
# Docker automator: paste output of `gh auth token` (host keyring is not visible in container)
GH_TOKEN=
GITHUB_ORG=autotests-cloud
GITHUB_TEMPLATE_DIR=templates/tests-java
# SSOT maintainer path — source for scripts/sync_rag_from_template_project.py only
TEMPLATE_PROJECT_DIR=/Users/stanislav/zero-design-system
GITHUB_PROJECTS_DIR=projects
AUTOMATION_CI_TIMEOUT_SEC=900
